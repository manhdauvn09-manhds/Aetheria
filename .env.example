# Aetheria — environment template. Copy to .env.local and fill in.

# ── Databases ──────────────────────────────────────────────────────────
# MySQL (shared, server-side master). Used by Prisma at prisma/mysql/.
DATABASE_URL_MYSQL="mysql://aetheria_app:change-me-app@localhost:3306/aetheria"

# SQLite (per-user, on-device). The api uses a factory that swaps the
# file path per user; this default is only used by `prisma migrate dev`.
DATABASE_URL_SQLITE="file:./.dev/aetheria-dev.db"

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET="change-me-32-bytes-min"
JWT_REFRESH_SECRET="change-me-32-bytes-min"

# ── OAuth (filled in Step 4.10) ────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ── Misc ───────────────────────────────────────────────────────────────
NODE_ENV="development"
