# Aetheria — environment template. Copy to .env.local and fill in.

# ── Databases ──────────────────────────────────────────────────────────
# MySQL (shared, server-side master). Used by Prisma at prisma/mysql/.
# Pool params (connection_limit, pool_timeout, connect_timeout) are auto-
# enriched by packages/schema-db/src/mysql.ts. Override them by appending
# explicit query params (e.g. ?connection_limit=20).
DATABASE_URL_MYSQL="mysql://aetheria_app:change-me-app@localhost:3306/aetheria"

# Optional: kill any single query that runs longer than this (seconds).
# Recommended for production app processes (set to 30 to match Fastify
# requestTimeout). LEAVE UNSET for migrations, batch jobs, and long
# admin queries — those need unlimited query time.
#   prod  app   → MYSQL_SOCKET_TIMEOUT="30"
#   dev / tools → leave empty
MYSQL_SOCKET_TIMEOUT=""

# SQLite (per-user, on-device). The api uses a factory that swaps the
# file path per user; this default is only used by `prisma migrate dev`.
DATABASE_URL_SQLITE="file:./.dev/aetheria-dev.db"

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET="change-me-32-bytes-min-change-me-32"
JWT_REFRESH_SECRET="change-me-32-bytes-min-change-me-rf"
JWT_ISSUER="aetheria"
JWT_AUDIENCE="aetheria-web"

# ── apps/api ───────────────────────────────────────────────────────────
API_HOST="0.0.0.0"
API_PORT="3000"
CORS_ORIGIN="http://localhost:3001"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="60000"

# ── apps/web ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ── OAuth (Google + Discord) ───────────────────────────────────────────
# Server-side verification needs only client_id (it consults Google's
# JWKS / Discord's /users/@me). client_secret lives on the web side
# (NextAuth) for the authorization-code exchange.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ── apps/web NextAuth ──────────────────────────────────────────────────
# Used by next-auth to sign session cookies. Generate via `openssl rand -base64 32`.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"

# ── Mailer (transactional email) ───────────────────────────────────────
# Resend (https://resend.com). When unset, the API uses a console mailer
# that prints would-be emails to stderr — fine for dev, useless for prod.
RESEND_API_KEY=""
MAIL_FROM="noreply@aetheria.local"

# Front-end URLs the password-reset / email-verification emails point at.
# The token is appended as `?token=…` by AuthService.
PASSWORD_RESET_URL="http://localhost:3001/reset-password"
EMAIL_VERIFICATION_URL="http://localhost:3001/verify-email"

# ── Misc ───────────────────────────────────────────────────────────────
NODE_ENV="development"
