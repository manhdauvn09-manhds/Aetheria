{
  "name": "@aetheria/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig / eslint / tailwind presets for the Aetheria monorepo.",
  "type": "module",
  "files": [
    "tsconfig",
    "eslint",
    "tailwind"
  ],
  "exports": {
    "./tsconfig/base":     "./tsconfig/base.json",
    "./tsconfig/library":  "./tsconfig/library.json",
    "./tsconfig/node":     "./tsconfig/node.json",
    "./tsconfig/nextjs":   "./tsconfig/nextjs.json",
    "./tsconfig/test":     "./tsconfig/test.json",
    "./eslint/node":       "./eslint/node.mjs",
    "./eslint/react":      "./eslint/react.mjs",
    "./eslint/test":       "./eslint/test.mjs",
    "./tailwind/preset":   "./tailwind/preset.cjs"
  },
  "scripts": {
    "lint": "echo 'config has no source to lint'",
    "typecheck": "echo 'config has no source to typecheck'",
    "test": "echo 'config has no tests'"
  },
  "peerDependencies": {
    "eslint": "^9.16.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.16.0",
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": { "optional": true }
  }
}
