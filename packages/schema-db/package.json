{
  "name": "@aetheria/schema-db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema + typed client for Aetheria's MySQL master database.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":      { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./mysql":{ "types": "./src/mysql.ts", "default": "./src/mysql.ts" }
  },
  "files": ["src", "prisma"],
  "scripts": {
    "generate":        "prisma generate --schema=prisma/mysql/schema.prisma",
    "migrate":         "prisma migrate deploy --schema=prisma/mysql/schema.prisma",
    "migrate:dev":     "prisma migrate dev --schema=prisma/mysql/schema.prisma",
    "studio":          "prisma studio --schema=prisma/mysql/schema.prisma",
    "build":           "tsc -p tsconfig.json",
    "typecheck":       "tsc -p tsconfig.json --noEmit",
    "lint":            "eslint src",
    "test":            "echo 'no tests yet'",
    "clean":           "rimraf dist .turbo src/generated"
  },
  "dependencies": {
    "@aetheria/shared-types": "workspace:*",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@aetheria/config": "workspace:*",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
