{
  "name": "@aetheria/schema-db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schemas + typed clients for Aetheria's hybrid MySQL (shared) + SQLite (per-user) databases.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":         { "types": "./src/index.ts",   "default": "./src/index.ts" },
    "./mysql":   { "types": "./src/mysql.ts",   "default": "./src/mysql.ts" },
    "./sqlite":  { "types": "./src/sqlite.ts",  "default": "./src/sqlite.ts" }
  },
  "files": ["src", "prisma"],
  "scripts": {
    "generate":         "pnpm generate:mysql && pnpm generate:sqlite",
    "generate:mysql":   "prisma generate --schema=prisma/mysql/schema.prisma",
    "generate:sqlite":  "prisma generate --schema=prisma/sqlite/schema.prisma",
    "migrate:mysql":    "prisma migrate deploy --schema=prisma/mysql/schema.prisma",
    "migrate:sqlite":   "prisma migrate deploy --schema=prisma/sqlite/schema.prisma",
    "migrate:dev:mysql":  "prisma migrate dev --schema=prisma/mysql/schema.prisma",
    "migrate:dev:sqlite": "prisma migrate dev --schema=prisma/sqlite/schema.prisma",
    "studio:mysql":     "prisma studio --schema=prisma/mysql/schema.prisma",
    "studio:sqlite":    "prisma studio --schema=prisma/sqlite/schema.prisma",
    "build":            "tsc -p tsconfig.json",
    "typecheck":        "tsc -p tsconfig.json --noEmit",
    "lint":             "eslint src",
    "test":             "echo 'no tests yet'",
    "clean":            "rimraf dist .turbo src/generated"
  },
  "dependencies": {
    "@aetheria/shared-types": "workspace:*",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@aetheria/config": "workspace:*",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
