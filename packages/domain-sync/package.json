{
  "name": "@aetheria/domain-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Aetheria sync engine — drains per-user SQLite sync_queue to MySQL, pulls catalog patches back.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":         { "types": "./src/index.ts",   "default": "./src/index.ts" },
    "./service": { "types": "./src/service.ts", "default": "./src/service.ts" },
    "./router":  { "types": "./src/router.ts",  "default": "./src/router.ts" }
  },
  "files": ["src"],
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint":      "eslint src",
    "test":      "echo 'no tests yet'",
    "clean":     "rimraf dist .turbo"
  },
  "dependencies": {
    "@aetheria/core":         "workspace:*",
    "@aetheria/schema-api":   "workspace:*",
    "@aetheria/schema-db":    "workspace:*",
    "@aetheria/shared-types": "workspace:*",
    "zod":                    "^3.23.8"
  },
  "devDependencies": {
    "@aetheria/config": "workspace:*",
    "@types/node":      "^22.9.0",
    "rimraf":           "^6.0.1",
    "typescript":       "^5.6.3"
  }
}
