{
  "name": "@aetheria/domain-social",
  "version": "0.0.0",
  "private": true,
  "description": "Aetheria social moderation — pure rules for content validation, profanity filtering, rate limits, and mute windows (no DB / I/O).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":          { "types": "./src/index.ts",      "default": "./src/index.ts" },
    "./rules":    { "types": "./src/rules.ts",      "default": "./src/rules.ts" },
    "./profanity":{ "types": "./src/profanity.ts",  "default": "./src/profanity.ts" }
  },
  "files": ["src"],
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint":      "eslint src",
    "test":      "vitest run",
    "clean":     "rimraf dist .turbo"
  },
  "dependencies": {
    "@aetheria/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@aetheria/config": "workspace:*",
    "@types/node":      "^22.9.0",
    "rimraf":           "^6.0.1",
    "typescript":       "^5.6.3",
    "vitest":           "^2.1.8"
  }
}
