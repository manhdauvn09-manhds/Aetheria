{
  "name": "@aetheria/domain-social",
  "version": "0.0.0",
  "private": true,
  "description": "Aetheria social moderation — pure rules for content validation, profanity filtering, rate limits, and mute windows (no DB / I/O).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":              { "types": "./src/index.ts",                  "default": "./src/index.ts" },
    "./rules":        { "types": "./src/rules.ts",                  "default": "./src/rules.ts" },
    "./profanity":    { "types": "./src/profanity.ts",              "default": "./src/profanity.ts" },
    "./guild":          { "types": "./src/guild/service.ts",          "default": "./src/guild/service.ts" },
    "./guild/router":   { "types": "./src/guild/router.ts",           "default": "./src/guild/router.ts" },
    "./guild/rules":    { "types": "./src/guild/rules.ts",            "default": "./src/guild/rules.ts" },
    "./friends":        { "types": "./src/friends/service.ts",        "default": "./src/friends/service.ts" },
    "./friends/router": { "types": "./src/friends/router.ts",         "default": "./src/friends/router.ts" },
    "./friends/rules":  { "types": "./src/friends/rules.ts",          "default": "./src/friends/rules.ts" },
    "./chat":           { "types": "./src/chat/service.ts",           "default": "./src/chat/service.ts" },
    "./chat/router":    { "types": "./src/chat/router.ts",            "default": "./src/chat/router.ts" },
    "./chat/publisher": { "types": "./src/chat/publisher.ts",         "default": "./src/chat/publisher.ts" }
  },
  "files": ["src"],
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint":      "eslint src",
    "test":      "vitest run",
    "clean":     "rimraf dist .turbo"
  },
  "dependencies": {
    "@aetheria/core":         "workspace:*",
    "@aetheria/schema-api":   "workspace:*",
    "@aetheria/schema-db":    "workspace:*",
    "@aetheria/shared-types": "workspace:*",
    "ioredis":                "^5.4.1",
    "zod":                    "^3.23.8"
  },
  "devDependencies": {
    "@aetheria/config": "workspace:*",
    "@types/node":      "^22.9.0",
    "rimraf":           "^6.0.1",
    "typescript":       "^5.6.3",
    "vitest":           "^2.1.8"
  }
}
