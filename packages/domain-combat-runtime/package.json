{
  "name": "@aetheria/domain-combat-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Aetheria combat runtime — bridges the pure engine to per-user SQLite runs (snapshot + action_log + audit).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":         { "types": "./src/index.ts",   "default": "./src/index.ts" },
    "./service": { "types": "./src/service.ts", "default": "./src/service.ts" },
    "./router":  { "types": "./src/router.ts",  "default": "./src/router.ts" }
  },
  "files": ["src"],
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint":      "eslint src",
    "test":      "vitest run",
    "clean":     "rimraf dist .turbo"
  },
  "dependencies": {
    "@aetheria/core":            "workspace:*",
    "@aetheria/domain-combat":   "workspace:*",
    "@aetheria/domain-events":   "workspace:*",
    "@aetheria/game-assets":     "workspace:*",
    "@aetheria/progression-runtime": "workspace:*",
    "@aetheria/schema-api":      "workspace:*",
    "@aetheria/schema-db":       "workspace:*",
    "@aetheria/shared-types":    "workspace:*",
    "zod":                       "^3.23.8"
  },
  "devDependencies": {
    "@aetheria/config": "workspace:*",
    "@types/node":      "^22.9.0",
    "rimraf":           "^6.0.1",
    "typescript":       "^5.6.3",
    "vitest":           "^2.1.8"
  }
}
