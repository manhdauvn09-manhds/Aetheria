{
  "name": "@aetheria/domain-combat",
  "version": "0.0.0",
  "private": true,
  "description": "Aetheria combat engine — pure-domain types, deterministic RNG, applyAction (no DB, no I/O).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":      { "types": "./src/index.ts",  "default": "./src/index.ts" },
    "./types":{ "types": "./src/types.ts",  "default": "./src/types.ts" },
    "./rng":  { "types": "./src/rng.ts",    "default": "./src/rng.ts" }
  },
  "files": ["src"],
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint":      "eslint src",
    "test":      "echo 'no tests yet'",
    "clean":     "rimraf dist .turbo"
  },
  "dependencies": {
    "@aetheria/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@aetheria/config": "workspace:*",
    "@types/node":      "^22.9.0",
    "rimraf":           "^6.0.1",
    "typescript":       "^5.6.3"
  }
}
