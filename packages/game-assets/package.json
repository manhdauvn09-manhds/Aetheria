{
  "name": "@aetheria/game-assets",
  "version": "0.0.0",
  "private": true,
  "description": "Aetheria static game content — sample levels (JSON), Zod schemas, typed loaders.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":         { "types": "./src/index.ts",        "default": "./src/index.ts" },
    "./schema":  { "types": "./src/level-schema.ts", "default": "./src/level-schema.ts" },
    "./levels":  { "types": "./src/levels.ts",       "default": "./src/levels.ts" }
  },
  "files": ["src", "levels"],
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint":      "eslint src",
    "test":      "echo 'no tests yet'",
    "clean":     "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aetheria/config": "workspace:*",
    "@types/node":      "^22.9.0",
    "rimraf":           "^6.0.1",
    "typescript":       "^5.6.3"
  }
}
