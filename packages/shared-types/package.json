{
  "name": "@aetheria/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-cutting TypeScript types shared by every Aetheria workspace.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":           { "types": "./src/index.ts",  "default": "./src/index.ts" },
    "./brands":    { "types": "./src/brands.ts", "default": "./src/brands.ts" },
    "./enums":     { "types": "./src/enums.ts",  "default": "./src/enums.ts" },
    "./errors":    { "types": "./src/errors.ts", "default": "./src/errors.ts" },
    "./result":    { "types": "./src/result.ts", "default": "./src/result.ts" }
  },
  "files": ["src"],
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint":      "eslint src",
    "test":      "echo 'no tests yet'",
    "clean":     "rimraf dist .turbo"
  },
  "devDependencies": {
    "@aetheria/config": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
