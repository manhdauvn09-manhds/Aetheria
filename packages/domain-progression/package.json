{
  "name": "@aetheria/domain-progression",
  "version": "0.0.0",
  "private": true,
  "description": "Aetheria progression engine — XP curve, level-up resolution, milestone unlocks (pure-domain, no DB / I/O).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":            { "types": "./src/index.ts",       "default": "./src/index.ts" },
    "./curve":      { "types": "./src/curve.ts",       "default": "./src/curve.ts" },
    "./milestones": { "types": "./src/milestones.ts",  "default": "./src/milestones.ts" }
  },
  "files": ["src"],
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint":      "eslint src",
    "test":      "vitest run",
    "clean":     "rimraf dist .turbo"
  },
  "dependencies": {
    "@aetheria/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@aetheria/config": "workspace:*",
    "@types/node":      "^22.9.0",
    "rimraf":           "^6.0.1",
    "typescript":       "^5.6.3",
    "vitest":           "^2.1.8"
  }
}
