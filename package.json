{
  "name": "aetheria",
  "version": "0.0.0",
  "private": true,
  "description": "Aetheria — online strategy + exploration + combat (web).",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf .turbo node_modules",
    "db:generate":       "pnpm --filter @aetheria/schema-db generate",
    "db:migrate:mysql":  "pnpm --filter @aetheria/schema-db migrate:mysql",
    "db:migrate:sqlite": "pnpm --filter @aetheria/schema-db migrate:sqlite",
    "db:studio:mysql":   "pnpm --filter @aetheria/schema-db studio:mysql",
    "db:studio:sqlite":  "pnpm --filter @aetheria/schema-db studio:sqlite"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0"
  }
}
