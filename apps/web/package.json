{
  "name": "@aetheria/web",
  "version": "0.0.0",
  "private": true,
  "description": "Aetheria web client — Next.js 15 (App Router) + Tailwind + tRPC + Zustand.",
  "type": "module",
  "scripts": {
    "dev":       "next dev --port 3001",
    "build":     "next build",
    "start":     "next start --port 3001",
    "lint":      "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test":      "echo 'no tests yet'",
    "clean":     "rimraf .next .turbo"
  },
  "dependencies": {
    "@aetheria/api":           "workspace:*",
    "@aetheria/core":          "workspace:*",
    "@aetheria/domain-combat": "workspace:*",
    "@aetheria/game-assets":   "workspace:*",
    "@aetheria/schema-api":    "workspace:*",
    "@aetheria/shared-types":  "workspace:*",
    "@tanstack/react-query":  "^4.36.1",
    "@trpc/client":           "^10.45.2",
    "@trpc/next":             "^10.45.2",
    "@trpc/react-query":      "^10.45.2",
    "@trpc/server":           "^10.45.2",
    "next":                   "^15.0.3",
    "next-auth":              "^4.24.10",
    "pixi.js":                "^8.5.0",
    "react":                  "^18.3.1",
    "react-dom":              "^18.3.1",
    "socket.io-client":       "^4.8.1",
    "superjson":              "^2.2.1",
    "zod":                    "^3.23.8",
    "zustand":                "^5.0.1"
  },
  "devDependencies": {
    "@aetheria/config":      "workspace:*",
    "@next/bundle-analyzer": "^15.0.3",
    "@types/node":           "^22.9.0",
    "@types/react":          "^18.3.12",
    "@types/react-dom":      "^18.3.1",
    "autoprefixer":          "^10.4.20",
    "eslint":                "^9.16.0",
    "eslint-config-next":    "^15.0.3",
    "postcss":               "^8.4.49",
    "rimraf":                "^6.0.1",
    "tailwindcss":           "^3.4.15",
    "typescript":            "^5.6.3"
  }
}
