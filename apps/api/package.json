{
  "name": "@aetheria/api",
  "version": "0.0.0",
  "private": true,
  "description": "Aetheria HTTP/tRPC API — Fastify + helmet + CORS + rate-limit + JWT.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./router": { "types": "./src/router.ts", "default": "./src/router.ts" }
  },
  "scripts": {
    "dev":       "tsx watch src/index.ts",
    "start":     "node dist/index.js",
    "build":     "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint":      "eslint src",
    "test":      "echo 'no tests yet'",
    "clean":     "rimraf dist .turbo"
  },
  "dependencies": {
    "@aetheria/core":           "workspace:*",
    "@aetheria/domain-account":         "workspace:*",
    "@aetheria/domain-auth":            "workspace:*",
    "@aetheria/domain-battlepass":      "workspace:*",
    "@aetheria/domain-combat-runtime":  "workspace:*",
    "@aetheria/domain-inventory":       "workspace:*",
    "@aetheria/domain-quests":          "workspace:*",
    "@aetheria/domain-roster":          "workspace:*",
    "@aetheria/domain-save":            "workspace:*",
    "@aetheria/domain-sync":            "workspace:*",
    "@aetheria/domain-world":           "workspace:*",
    "@aetheria/game-assets":    "workspace:*",
    "@aetheria/schema-api":     "workspace:*",
    "@aetheria/schema-db":    "workspace:*",
    "@aetheria/shared-types": "workspace:*",
    "@fastify/cors":          "^10.0.1",
    "@fastify/helmet":        "^12.0.1",
    "@fastify/rate-limit":    "^10.2.1",
    "@trpc/server":           "^10.45.2",
    "fastify":                "^5.1.0",
    "ioredis":                "^5.4.1",
    "jose":                   "^5.9.6",
    "pino-pretty":            "^11.3.0",
    "zod":                    "^3.23.8"
  },
  "devDependencies": {
    "@aetheria/config": "workspace:*",
    "@types/node":      "^22.9.0",
    "rimraf":           "^6.0.1",
    "tsx":              "^4.19.2",
    "typescript":       "^5.6.3"
  }
}
