# =============================================================================
# Aetheria — PRODUCTION env template (deployed as /opt/apps/aetheria/src/.env.prod)
# =============================================================================
# This file lives on the SERVER, not in git. The deploy.ps1 script will create
# it via SSH on first run from the values you provide locally.
#
# Regenerate any "change-me-*" placeholder BEFORE the first deploy.
# Strong secrets:
#   openssl rand -base64 48    (for JWT_*)
#   openssl rand -base64 32    (for NEXTAUTH_SECRET)
# =============================================================================

# ─── MySQL (in-stack — internal only) ────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root-strong-pw
MYSQL_DATABASE=aetheria
MYSQL_USER=aetheria_app
MYSQL_PASSWORD=change-me-app-strong-pw

# ─── JWT / NextAuth secrets ──────────────────────────────────────────
JWT_SECRET=replace-me-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-me-different-openssl-rand-base64-48
JWT_ISSUER=aetheria
JWT_AUDIENCE=aetheria-web
NEXTAUTH_SECRET=replace-me-openssl-rand-base64-32

# ─── Public URLs (production) ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aetheria.games-core.com
NEXT_PUBLIC_APP_URL=https://aetheria.games-core.com
NEXT_PUBLIC_API_URL=https://aetheria-api.games-core.com
NEXT_PUBLIC_REALTIME_URL=https://aetheria-ws.games-core.com
NEXTAUTH_URL=https://aetheria.games-core.com
CORS_ORIGIN=https://aetheria.games-core.com
PASSWORD_RESET_URL=https://aetheria.games-core.com/reset-password
EMAIL_VERIFICATION_URL=https://aetheria.games-core.com/verify-email

# ─── Optional: OAuth providers ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── Optional: mailer (Resend) ───────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=noreply@aetheria.games-core.com

# ─── Tuning ──────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Cloudflare-fronting toggle. If you use Cloudflare proxied DNS, set true
# so the API trusts `cf-connecting-ip` and rejects direct-to-origin traffic.
ENFORCE_CLOUDFLARE=false
PVP_SEASON_ID=1
REALTIME_INSTANCES=1
REALTIME_MAX_SOCKETS=1000
