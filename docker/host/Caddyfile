# =============================================================================
# HOST-level Caddy reverse proxy — Cloudflare Flexible SSL topology.
# =============================================================================
# Cloudflare terminates TLS at its edge and forwards HTTP (port 80) to this
# origin. Caddy speaks HTTP only — auto_https off so it doesn't try to
# provision LE certs (would fail behind CF anyway).
#
# Real client IP arrives via `CF-Connecting-IP`. We forward that header
# upstream as X-Real-IP / X-Forwarded-For without bothering with the
# `trusted_proxies` plumbing — for Flexible-mode behind CF, the immediate
# peer is *always* a CF edge, so trusting them implicitly is fine.
#
# Stack ports (127.0.0.1 loopback only):
#   18080  PrivateDatingLevel nginx (pld-prod)
#   18100  Aetheria web        (Next.js)
#   18101  Aetheria api        (Fastify+tRPC)
#   18102  Aetheria realtime   (Socket.IO)
# =============================================================================

{
	auto_https off
}

(cf_headers) {
	header_up X-Real-IP {http.request.header.cf-connecting-ip}
	header_up X-Forwarded-For {http.request.header.cf-connecting-ip}
	header_up X-Forwarded-Proto https
}

# ─── Aetheria — game web ─────────────────────────────────────────────
http://aetheria.games-core.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18100 {
		import cf_headers
	}
}

# ─── Aetheria — tRPC HTTP API ────────────────────────────────────────
http://aetheria-api.games-core.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18101 {
		import cf_headers
		# API uses CF-Connecting-IP under ENFORCE_CLOUDFLARE=true to
		# reject direct-to-origin traffic. Forward verbatim.
		header_up CF-Connecting-IP {http.request.header.cf-connecting-ip}
	}
}

# ─── Aetheria — Socket.IO realtime gateway ───────────────────────────
http://aetheria-ws.games-core.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18102 {
		import cf_headers
		flush_interval -1
	}
}

# ─── PrivateDatingLevel ──────────────────────────────────────────────
# Single shared edge serves both products. PLD's nginx binds 127.0.0.1:18080
# (see /opt/apps/pld/src/docker-compose.prod.yml when they redeploy).
http://privatedatinglevelup.allin1site.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18080 {
		import cf_headers
	}
}
