# =============================================================================
# HOST-level Caddy reverse proxy.
# =============================================================================
# Two CF SSL topologies on this box, both targeting Full (strict):
#
#  Zone games-core.com (Aetheria)  -> CF Full (strict)  -> origin HTTPS required
#     Aetheria has two blocks per host (one :80, one :443). :443 uses a
#     Cloudflare Origin CA cert (free, valid 15 years, trusted by CF only —
#     browsers see CF edge cert). Cert: /etc/caddy/certs/games-core-origin.{pem,key}.
#
#  Zone allin1site.com (PLD)       -> CF Full/Strict -> origin HTTPS required
#     Same pattern. Cert: /etc/caddy/certs/pld-origin.{pem,key}.
#
# The :80 blocks survive for:
#   - ACME challenges (if you ever migrate to Let's Encrypt)
#   - a temporary fallback if CF flips back to Flexible during debugging
# CF won't normally hit them once SSL mode is Full (strict).
#
# Global `auto_https off` keeps Caddy from trying to grab LE certs for the
# http:// blocks (would fail behind CF proxy anyway). HTTPS is wired
# explicitly via `tls` directive against the Origin CA cert.
#
# Real client IP arrives via `CF-Connecting-IP` — forwarded upstream as
# X-Real-IP / X-Forwarded-For. For CF-fronted traffic the immediate peer is
# always a CF edge, so trusting CF-Connecting-IP implicitly is fine.
#
# Stack ports (127.0.0.1 loopback only):
#   18080  PrivateDatingLevel nginx (pld-prod)
#   18100  Aetheria web        (Next.js)
#   18101  Aetheria api        (Fastify+tRPC)
#   18102  Aetheria realtime   (Socket.IO)
# =============================================================================

{
	auto_https off
}

(cf_headers) {
	header_up X-Real-IP {http.request.header.cf-connecting-ip}
	header_up X-Forwarded-For {http.request.header.cf-connecting-ip}
	header_up X-Forwarded-Proto https
}

# ─── Upstream snippets (one per backend) ─────────────────────────────
(aetheria_web_upstream) {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18100 {
		import cf_headers
	}
}

(aetheria_api_upstream) {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18101 {
		import cf_headers
		# API uses CF-Connecting-IP under ENFORCE_CLOUDFLARE=true to
		# reject direct-to-origin traffic. Forward verbatim.
		header_up CF-Connecting-IP {http.request.header.cf-connecting-ip}
	}
}

(aetheria_ws_upstream) {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18102 {
		import cf_headers
		flush_interval -1
	}
}

(pld_upstream) {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18080 {
		import cf_headers
	}
}

# ─── Aetheria — :80 (debug + ACME fallback) ──────────────────────────
http://aetheria.games-core.com {
	import aetheria_web_upstream
}

http://aetheria-api.games-core.com {
	import aetheria_api_upstream
}

http://aetheria-ws.games-core.com {
	import aetheria_ws_upstream
}

# ─── Aetheria — :443 with Origin CA cert (required for Full strict) ──
https://aetheria.games-core.com {
	tls /etc/caddy/certs/games-core-origin.pem /etc/caddy/certs/games-core-origin.key
	import aetheria_web_upstream
}

https://aetheria-api.games-core.com {
	tls /etc/caddy/certs/games-core-origin.pem /etc/caddy/certs/games-core-origin.key
	import aetheria_api_upstream
}

https://aetheria-ws.games-core.com {
	tls /etc/caddy/certs/games-core-origin.pem /etc/caddy/certs/games-core-origin.key
	import aetheria_ws_upstream
}

# ─── PrivateDatingLevel — HTTP :80 (debug + ACME fallback) ───────────
http://privatedatinglevelup.allin1site.com {
	import pld_upstream
}

# ─── PrivateDatingLevel — HTTPS :443 with Origin CA cert ─────────────
# Single-subdomain layout: web + /api/v1/* + /<ADMIN_SECRET_PATH>/ all
# served from this one host. PLD internal nginx (127.0.0.1:18080) does
# path routing into the services.
https://privatedatinglevelup.allin1site.com {
	tls /etc/caddy/certs/pld-origin.pem /etc/caddy/certs/pld-origin.key
	import pld_upstream
}
