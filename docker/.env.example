# Aetheria — docker-compose env template.
# Copy to .env.docker at the repo root and fill in real values:
#   cp docker/.env.example .env.docker
#
# Then bring up the stack:
#   docker compose --env-file .env.docker up --build

# ─── MySQL ─────────────────────────────────────────────────────────────
# Generate strong values; these are the initial bootstrap secrets MySQL
# uses on first start of the volume.
MYSQL_ROOT_PASSWORD=change-me-root-strong-pw
MYSQL_DATABASE=aetheria
MYSQL_USER=aetheria_app
MYSQL_PASSWORD=change-me-app-strong-pw

# ─── JWT secrets ──────────────────────────────────────────────────────
# Must be ≥ 32 bytes and high-entropy. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48-output
JWT_REFRESH_SECRET=replace-me-with-different-openssl-rand-base64-48
JWT_ISSUER=aetheria
JWT_AUDIENCE=aetheria-web

# NextAuth signing key — separate from the API JWT secret.
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32

# ─── Public URLs ──────────────────────────────────────────────────────
# Local dev (PowerShell on Windows) — these resolve thanks to .localhost
# being auto-routed to 127.0.0.1 by modern browsers + Windows hosts.
NEXT_PUBLIC_SITE_URL=http://aetheria.localhost
NEXT_PUBLIC_APP_URL=http://aetheria.localhost
NEXT_PUBLIC_API_URL=http://api.aetheria.localhost
NEXT_PUBLIC_REALTIME_URL=http://ws.aetheria.localhost
NEXTAUTH_URL=http://aetheria.localhost
CORS_ORIGIN=http://aetheria.localhost
PASSWORD_RESET_URL=http://aetheria.localhost/reset-password
EMAIL_VERIFICATION_URL=http://aetheria.localhost/verify-email

# Caddy reverse-proxy site addresses (Caddyfile reads these).
CADDY_WEB_HOST=http://aetheria.localhost
CADDY_API_HOST=http://api.aetheria.localhost
CADDY_WS_HOST=http://ws.aetheria.localhost
# Set to `on` and switch the *_HOST values to https:// once DNS is live.
CADDY_AUTO_HTTPS=off
CADDY_ACME_EMAIL=admin@aetheria.games-core.com

# ─── Optional: OAuth providers ────────────────────────────────────────
# Leave blank to disable the matching login path. Server-side verification
# (apps/api) only needs the CLIENT_ID; NextAuth (apps/web) needs both.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── Optional: mailer (Resend) ────────────────────────────────────────
# When unset, password-reset / email-verification mails go to API stderr.
RESEND_API_KEY=
MAIL_FROM=noreply@aetheria.games-core.com

# ─── Tuning ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
ENFORCE_CLOUDFLARE=false
PVP_SEASON_ID=1
REALTIME_INSTANCES=1
REALTIME_MAX_SOCKETS=1000

# ─── Production deploy notes (commented out for local dev) ────────────
# Swap these in when DNS is pointed at the box:
# NEXT_PUBLIC_SITE_URL=https://aetheria.games-core.com
# NEXT_PUBLIC_APP_URL=https://aetheria.games-core.com
# NEXT_PUBLIC_API_URL=https://aetheria-api.games-core.com
# NEXT_PUBLIC_REALTIME_URL=https://aetheria-ws.games-core.com
# NEXTAUTH_URL=https://aetheria.games-core.com
# CORS_ORIGIN=https://aetheria.games-core.com
# CADDY_WEB_HOST=https://aetheria.games-core.com
# CADDY_API_HOST=https://aetheria-api.games-core.com
# CADDY_WS_HOST=https://aetheria-ws.games-core.com
# NOTE: CF Free plan supports only 1-level wildcard. Use dash naming
# (aetheria-api.games-core.com), NOT subsubdomain (api.aetheria.games-core.com).
# CADDY_AUTO_HTTPS=on
# ENFORCE_CLOUDFLARE=true   # if fronting via Cloudflare
